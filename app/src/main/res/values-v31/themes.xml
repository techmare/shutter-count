<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+: the system splash shows the aperture on the icon's dark background, exactly
         as LaunchReveal draws its first frame, so the hand-over to the opening animation is seamless. -->
    <style name="Theme.ShutterCount" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:windowSplashScreenBackground">@color/icon_bg</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
    </style>
</resources>
